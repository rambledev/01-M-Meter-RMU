# Copy to .env for local development. Do not commit .env.

# PostgreSQL 17 (docker-compose service: db) — placeholders only, not real credentials
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=YOUR_DATABASE

# Used by `npm run dev` on the host, connecting to the PostgreSQL
# container exposed port from docker-compose.
# Phase 1 introduces the actual Prisma schema/tables.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DATABASE?schema=public"


# NOTE:
# Do NOT set NODE_ENV manually.
# Next.js automatically manages NODE_ENV:
# - npm run dev  -> development
# - next build   -> production
# - next start   -> production


# Set to "true" to run the whole app on an in-memory mock dataset instead
# of PostgreSQL (src/lib/db/mockStore.ts + mockPrisma.ts) — for demoing or
# developing with zero network dependency, e.g. while DATABASE_URL is
# unreachable.
# Leave unset/"false" for normal real-database operation.
MOCK_DATA=false


# Google Cloud OAuth 2.0 Client ID
# https://console.cloud.google.com/apis/credentials
#
# Used by role RESIDENT's "Sign in with Google" login.
# Restricted server-side to @rmu.ac.th emails only
# (src/lib/resident/googleAuth.ts).
#
# Public NEXT_PUBLIC_ variable because it is required client-side
# to render Google's own sign-in button
# (src/components/resident/GoogleSignInButton.tsx).
#
# OAuth Client IDs are not considered secrets.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# Field Calibration testing convenience (see docs/meter-calibration.md) —
# when BOTH are set, /checker skips the login screen and auto-logs in as
# this account instead (src/components/checker/CheckerAuthGate.tsx), so a
# tester can jump straight to /checker/reading without typing credentials
# every time. Goes through the real login API, so the account must exist
# for real — run `node prisma/ensureCheckerBypassUser.cjs` once to create/
# update a matching "checker-01" METER_READER account (all zones).
#
# Must be NEXT_PUBLIC_ to reach the client bundle at all (same as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID above) — meaning the password ends up in the
# client bundle too. Leave both unset outside of active field testing.
NEXT_PUBLIC_CHECKER_BYPASS_USERNAME=
NEXT_PUBLIC_CHECKER_BYPASS_PASSWORD=