# Copy to .env for local development. Do not commit .env.

# PostgreSQL 17 (docker-compose service: db) — placeholders only, not real credentials
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=YOUR_DATABASE

# Used by `npm run dev` on the host, connecting to the port docker-compose
# exposes on localhost. Phase 1 introduces the actual Prisma schema/tables.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DATABASE?schema=public"

NODE_ENV=development

# Set to "true" to run the whole app on an in-memory mock dataset instead
# of PostgreSQL (src/lib/db/mockStore.ts + mockPrisma.ts) — for demoing or
# developing with zero network dependency, e.g. while DATABASE_URL is
# unreachable. Leave unset/"false" for normal real-database operation.
MOCK_DATA=false

# Google Cloud OAuth 2.0 Client ID (https://console.cloud.google.com/apis/credentials)
# used by role RESIDENT's "Sign in with Google" login, restricted server-side
# to @rmu.ac.th emails only (src/lib/resident/googleAuth.ts). Public (NEXT_PUBLIC_)
# because it's also needed client-side to render Google's own sign-in button
# (src/components/resident/GoogleSignInButton.tsx) — this is normal for OAuth
# client IDs, they are not secret. Without it, the resident login page shows
# a "not configured" message instead of the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
